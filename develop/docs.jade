doctype
html

   include assets/jade/static/__head
   +title( 'Конкурс бережливых технологий | Документы' )

   body
      .cover_block.cover_docs
         include assets/jade/header/__menu
         +menu( '', '', 'active', '', '')

         .wrapper.block_main__flex
            .block_main__caption.max-half
               h1.h1 Документы для конкурса
               .block__data Все необходимые документы  для&nbsp;участия во&nbsp;Всероссийском конкурсе

               .block__buttons.mt24
                  include assets/jade/content/__btn-main



      .wrapper.block__holder
         include assets/jade/content/__block-half-btn
         section.row
            +half-btn( 'docs', '1', 'Приказ Минпросвещения России о&nbsp;проведении конкурса', 'Приказ_№407_от_10.06.2026.pdf')
            +half-btn( 'docs', '2', 'Положение о&nbsp;проведении конкурса', 'Положение_о_Всероссийском_конкурсе_лучших_практик_внедрения_бережливых_технологий.pdf')
            +half-btn( 'docs', '3', 'Заявка на&nbsp;участие', 'Шаблон_заявки_на_участие_в_конкурсе.docx?v=2')
            +half-btn( 'docs', '4', 'Шаблон резюме', 'Шаблон_резюме_проекта.docx?v=2')
            +half-btn( 'docs', '5', 'Шаблон методической разработки', 'Шаблон_методической_разработки_проекта.docx?v=2')
            +half-btn( 'docs', '6', 'Требования к&nbsp;видеовизитке', 'Требования_к_видео визитке.pdf?v=2')



      include assets/jade/static/to-top
      include assets/jade/static/form

      script( src='./assets/js/jquery.js' )
      script( src='./assets/js/script.js' )
